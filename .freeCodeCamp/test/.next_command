builtin unset VSCODE_INJECTION
[ -z "$VSCODE_SHELL_INTEGRATION" ]
[ "${VSCODE_PREVENT_SHELL_HISTORY:-}" = "1" ]
export HISTCONTROL="ignorespace"
builtin unset VSCODE_PREVENT_SHELL_HISTORY
[ -n "${VSCODE_ENV_REPLACE:-}" ]
[ -n "${VSCODE_ENV_PREPEND:-}" ]
[ -n "${VSCODE_ENV_APPEND:-}" ]
[ -z "${VSCODE_PYTHON_AUTOACTIVATE_GUARD:-}" ]
export VSCODE_PYTHON_AUTOACTIVATE_GUARD=1
[ -n "${VSCODE_PYTHON_BASH_ACTIVATE:-}" ]
for var in "${!VSCODE_PYTHON_@}"
case "$var" in
__vsc_regex_environment="^CYGWIN*|MINGW*|MSYS*"
[[ "$(uname -s)" =~ $__vsc_regex_environment ]]
__vsc_is_windows=0
__vsc_regex_histcontrol=".*(erasedups|ignoreboth|ignoredups|ignorespace).*"
[[ "${HISTCONTROL:-}" =~ $__vsc_regex_histcontrol ]]
__vsc_history_verify=0
builtin unset __vsc_regex_environment
builtin unset __vsc_regex_histcontrol
__vsc_initialized=0
__vsc_original_PS1="$PS1"
__vsc_original_PS2="$PS2"
__vsc_custom_PS1=""
__vsc_custom_PS2=""
__vsc_in_command_execution="1"
__vsc_current_command=""
__vsc_nonce="$VSCODE_NONCE"
unset VSCODE_NONCE
__vsc_stable="$VSCODE_STABLE"
unset VSCODE_STABLE
[ "$__vsc_stable" = "0" ]
[ -n "$STARSHIP_SESSION_KEY" ]
[ -n "$POSH_SESSION_ID" ]
builtin printf '\e]633;P;HasRichCommandDetection=True\a'
[[ -n "${bash_preexec_imported:-}" ]]
__vsc_dbg_trap="$(__vsc_get_trap DEBUG)"
[[ -z "$__vsc_dbg_trap" ]]
[[ "$__vsc_dbg_trap" != '__vsc_preexec "$_"' && "$__vsc_dbg_trap" != '__vsc_preexec_all "$_"' ]]
trap '__vsc_preexec_all "$_"' DEBUG
__vsc_original_prompt_command=${PROMPT_COMMAND:-}
psql --username=freecodecamp --dbname=postgres -c "\d moon" -c "SELECT name, planet_id, shape, active FROM moon ORDER BY planet_id, name;"
psql --username=freecodecamp --dbname=postgres -c "SELECT current_database(), current_user;" -c "\dt *.*"
psql --username=freecodecamp --dbname=postgres -c "\l"
psql --username=freecodecamp --dbname=universe -c "\d moon" -c "SELECT name, planet_id, shape, active FROM moon ORDER BY planet_id, name;"
psql --username=freecodecamp --dbname=universe -c "SELECT planet_id, name FROM planet WHERE planet_id IN (4, 5, 6, 7, 8) ORDER BY planet_id;" -c "SELECT COUNT(*) AS existing_moons FROM moon;"
psql --username=freecodecamp --dbname=universe -v ON_ERROR_STOP=1 -c "BEGIN; INSERT INTO moon (name, planet_id, shape, active) VALUES ('Phobos', 4, 'irregular', FALSE), ('Deimos', 4, 'irregular', FALSE), ('Io', 5, 'spherical', TRUE), ('Europa', 5, 'spherical', FALSE), ('Ganymede', 5, 'spherical', FALSE), ('Callisto', 5, 'spherical', FALSE), ('Titan', 6, 'spherical', FALSE), ('Enceladus', 6, 'spherical', TRUE), ('Rhea', 6, 'spherical', FALSE), ('Iapetus', 6, 'spherical', FALSE), ('Dione', 6, 'spherical', FALSE), ('Tethys', 6, 'spherical', FALSE), ('Mimas', 6, 'spherical', FALSE), ('Miranda', 7, 'spherical', FALSE), ('Ariel', 7, 'spherical', FALSE), ('Umbriel', 7, 'spherical', FALSE), ('Titania', 7, 'spherical', FALSE), ('Oberon', 7, 'spherical', FALSE), ('Triton', 8, 'spherical', FALSE); COMMIT;" -c "SELECT COUNT(*) AS inserted_moons, COUNT(*) FILTER (WHERE active) AS volcanically_active FROM moon;"
builtin unset VSCODE_INJECTION
[ -z "$VSCODE_SHELL_INTEGRATION" ]
[ "${VSCODE_PREVENT_SHELL_HISTORY:-}" = "1" ]
[ -n "${VSCODE_ENV_REPLACE:-}" ]
[ -n "${VSCODE_ENV_PREPEND:-}" ]
[ -n "${VSCODE_ENV_APPEND:-}" ]
[ -z "${VSCODE_PYTHON_AUTOACTIVATE_GUARD:-}" ]
export VSCODE_PYTHON_AUTOACTIVATE_GUARD=1
[ -n "${VSCODE_PYTHON_BASH_ACTIVATE:-}" ]
for var in "${!VSCODE_PYTHON_@}"
case "$var" in
__vsc_regex_environment="^CYGWIN*|MINGW*|MSYS*"
[[ "$(uname -s)" =~ $__vsc_regex_environment ]]
__vsc_is_windows=0
__vsc_regex_histcontrol=".*(erasedups|ignoreboth|ignoredups|ignorespace).*"
[[ "${HISTCONTROL:-}" =~ $__vsc_regex_histcontrol ]]
__vsc_history_verify=1
builtin unset __vsc_regex_environment
builtin unset __vsc_regex_histcontrol
__vsc_initialized=0
__vsc_original_PS1="$PS1"
__vsc_original_PS2="$PS2"
__vsc_custom_PS1=""
__vsc_custom_PS2=""
__vsc_in_command_execution="1"
__vsc_current_command=""
__vsc_nonce="$VSCODE_NONCE"
unset VSCODE_NONCE
__vsc_stable="$VSCODE_STABLE"
unset VSCODE_STABLE
[ "$__vsc_stable" = "0" ]
[ -n "$STARSHIP_SESSION_KEY" ]
[ -n "$POSH_SESSION_ID" ]
builtin printf '\e]633;P;HasRichCommandDetection=True\a'
[[ -n "${bash_preexec_imported:-}" ]]
__vsc_dbg_trap="$(__vsc_get_trap DEBUG)"
[[ -z "$__vsc_dbg_trap" ]]
[[ "$__vsc_dbg_trap" != '__vsc_preexec "$_"' && "$__vsc_dbg_trap" != '__vsc_preexec_all "$_"' ]]
trap '__vsc_preexec_all "$_"' DEBUG
__vsc_original_prompt_command=${PROMPT_COMMAND:-}
pg_dump -cC --inserts -U freecodecamp universe > universe.sql
